STAGING_HTPASSWD_FILE=/opt/movemap-staging/secrets/staging.htpasswd
# OAuth 로그인을 테스트하는 develop 프리뷰는 staging-headers@file만 지정하면
# 외부 인증 왕복 뒤 Basic Auth가 다시 표시되지 않는다.
PREVIEW_MIDDLEWARES=staging-auth@file,staging-headers@file
