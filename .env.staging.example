NODE_ENV=production
APP_ENV=staging
PORT=8090
REQUIRE_HTTPS=true
ALLOWED_ORIGINS=https://staging.movemap.example,https://preview.movemap.example

# Staging secrets must be stored in the hosting provider or cloud secret manager.
AUTH_PROVIDER=
NAVER_MAP_NCP_KEY_ID=
EXPO_PUBLIC_API_BASE_URL=https://staging-api.movemap.example
DATABASE_URL_SECRET_NAME=movemap/staging/database-url
AES_256_GCM_KEY_SECRET_NAME=movemap/staging/patient-field-key
SESSION_SECRET_NAME=movemap/staging/session-secret
FILE_STORAGE_BUCKET_SECRET_NAME=movemap/staging/private-file-bucket

# Staging must use fake data only.
MOVEMAP_DB_PATH=
LOCAL_ADMIN_PASSWORD=
