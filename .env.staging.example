NODE_ENV=production
APP_ENV=staging
DATA_ENVIRONMENT=staging
PORT=3000
MOVEMAP_DOMAIN=staging.157-90-26-205.sslip.io
EXPO_PUBLIC_API_BASE_URL=https://develop.157-90-26-205.sslip.io
PUBLIC_APP_ORIGIN=https://develop.157-90-26-205.sslip.io
NAVER_MAP_NCP_KEY_ID=
SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=movemap-private-staging
KAKAO_AUTH_ENABLED=false
APPLE_AUTH_ENABLED=false
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
USER_AUTH_STATE_SECRET=
EXPECTED_SUPABASE_PROJECT_REF=STAGING_PROJECT_REF
