{
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config"
    },
    {
      "source": "/api/centers",
      "destination": "/api/centers"
    },
    {
      "source": "/api/events",
      "destination": "/api/events"
    },
    {
      "source": "/api/center-applications",
      "destination": "/api/center-applications"
    },
    {
      "source": "/register",
      "destination": "/register/index.html"
    },
    {
      "source": "/register/",
      "destination": "/register/index.html"
    },
    {
      "source": "/register/:path*",
      "destination": "/register/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/:path*"
    },
    {
      "source": "/web/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
