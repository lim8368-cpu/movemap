NODE_ENV=development
PORT=8090

# Comma-separated list. Never use "*" in production.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Local-only safety controls.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=160
REQUIRE_HTTPS=false
LOCAL_ADMIN_PASSWORD=change-this-in-your-local-env

# Naver Maps JavaScript SDK Client ID. This is not the Client Secret.
# Keep the real value in your local .env or cloud environment settings.
NAVER_MAP_NCP_KEY_ID=

# Local JSON DB path. Do not commit real local/production DB files.
MOVEMAP_DB_PATH=server/data/db.local.json

# Production values must live in a cloud secret manager, not in this file.
AUTH_PROVIDER=
DATABASE_URL_SECRET_NAME=movemap/prod/database-url
AES_256_GCM_KEY_SECRET_NAME=movemap/prod/patient-field-key
SESSION_SECRET_NAME=movemap/prod/session-secret
FILE_STORAGE_BUCKET_SECRET_NAME=movemap/prod/private-file-bucket
