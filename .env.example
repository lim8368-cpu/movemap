NODE_ENV=development
APP_ENV=development
PORT=8090

# Expo bundles only variables with the EXPO_PUBLIC_ prefix. This value is public.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8090

# Comma-separated list. Never use "*" in production.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Local-only safety controls.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=160
REQUIRE_HTTPS=false
LOCAL_ADMIN_PASSWORD=change-this-in-your-local-env

# Naver Maps JavaScript SDK Client ID. This is not the Client Secret.
# Keep the real value in your local .env or cloud environment settings.
NAVER_MAP_NCP_KEY_ID=

# Optional local development Supabase project. Never reuse the production project.
# Keep the real service-role key only in the untracked local env file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=movemap-private

# Social login. Provider secrets belong only in untracked environment files.
KAKAO_AUTH_ENABLED=false
APPLE_AUTH_ENABLED=false
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
USER_AUTH_STATE_SECRET=

# Generate these with: npm run admin:credentials
ADMIN_PASSWORD_SCRYPT=
ADMIN_SESSION_SECRET=

# Local JSON DB path. Do not commit real local/production DB files.
MOVEMAP_DB_PATH=server/data/db.local.json

# Production values must live in a cloud secret manager, not in this file.
AUTH_PROVIDER=
DATABASE_URL_SECRET_NAME=movemap/prod/database-url
AES_256_GCM_KEY_SECRET_NAME=movemap/prod/patient-field-key
SESSION_SECRET_NAME=movemap/prod/session-secret
FILE_STORAGE_BUCKET_SECRET_NAME=movemap/prod/private-file-bucket
