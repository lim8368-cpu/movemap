# Expo skips JavaScript bundling in every Debug build by default. That works for
# simulators connected to Metro, but a physical iPhone can then launch with no
# script URL. Embed the bundle for Debug device builds while keeping simulator
# builds fast and Metro-driven.
if [[ "$CONFIGURATION" = *Debug* && "$PLATFORM_NAME" != *simulator* ]]; then
  unset SKIP_BUNDLING
  # Keep native Debug diagnostics, but embed production-mode JavaScript so the
  # standalone device build does not initialize Metro-only devtools.
  export CONFIGURATION=Release
fi
