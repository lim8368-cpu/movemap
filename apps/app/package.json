{
  "name": "movemap-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "APP_ENV=development expo start",
    "start:staging": "APP_ENV=staging expo start",
    "start:production": "APP_ENV=production expo start",
    "ios": "APP_ENV=development expo start --ios",
    "ios:staging": "APP_ENV=staging expo start --ios",
    "ios:production": "APP_ENV=production expo start --ios",
    "android": "APP_ENV=development expo start --android",
    "android:staging": "APP_ENV=staging expo start --android",
    "android:production": "APP_ENV=production expo start --android",
    "web": "APP_ENV=development expo start --web",
    "web:staging": "APP_ENV=staging expo start --web",
    "web:production": "APP_ENV=production expo start --web"
  },
  "dependencies": {
    "expo": "~54.0.35",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/cli": "^54.0.21"
  }
}
