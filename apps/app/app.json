{
  "expo": {
    "name": "무브맵",
    "slug": "movemap",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.movemap.app",
      "infoPlist": {
        "NSCameraUsageDescription": "센터 등록에 필요한 센터 및 면허 증빙 사진을 촬영할 때 사용합니다.",
        "NSPhotoLibraryUsageDescription": "센터 등록에 필요한 센터 및 면허 증빙 사진을 선택할 때 사용합니다."
      }
    },
    "android": {
      "package": "com.movemap.app",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#2f9b76"
      }
    }
  }
}
