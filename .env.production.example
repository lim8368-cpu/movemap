NODE_ENV=production
APP_ENV=production
DATA_ENVIRONMENT=production
MOVEMAP_DOMAIN=example.com
IOS_APP_STORE_URL=
GOOGLE_PLAY_STORE_URL=

NAVER_MAP_NCP_KEY_ID=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
AUTH_SUPABASE_URL=https://PROJECT_REF.supabase.co
AUTH_SUPABASE_ANON_KEY=
AUTH_SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=movemap-private
EXPECTED_SUPABASE_PROJECT_REF=PRODUCTION_PROJECT_REF
EXPECTED_AUTH_SUPABASE_PROJECT_REF=PRODUCTION_PROJECT_REF
ADMIN_PASSWORD_SCRYPT=
ADMIN_SESSION_SECRET=
SUPER_ADMIN_EMAIL=admin@example.com
# Set false after the Supabase Auth super-admin and MFA enrollment are verified.
ALLOW_LEGACY_ADMIN_LOGIN=true
OWNER_SESSION_SECRET=
CENTER_CLIENT_DATA_KEYS=
CENTER_CLIENT_DATA_ACTIVE_VERSION=v1
CENTER_CLIENT_LOOKUP_SECRET=
REGISTRATION_CHALLENGE_SECRET=
PARTNER_INVITE_ENFORCEMENT=enabled
# Resend에서 dail.life 발신 도메인을 인증한 뒤 설정합니다. 비어 있으면 링크를 수동 전달합니다.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=DAIL <partner@dail.life>
TRANSACTIONAL_EMAIL_REPLY_TO=
ANALYTICS_SESSION_SECRET=
LOG_HASH_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ALERT_WEBHOOK_URL=
APP_MEMORY_ALERT_MB=400
APP_CPU_ALERT_PERCENT=85
APP_DB_SIZE_ALERT_MB=400
APP_DB_CONNECTION_ALERT_PERCENT=80
KAKAO_AUTH_ENABLED=false
APPLE_AUTH_ENABLED=false
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
USER_AUTH_STATE_SECRET=

# Supabase Dashboard > Connect에서 Transaction pooler 연결 문자열을 사용합니다.
DATABASE_URL=

# Supabase Dashboard > Storage > S3에서 생성합니다.
SUPABASE_S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Cloudflare R2의 별도 비공개 버킷을 백업 대상으로 사용합니다.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/movemap-backups
RESTIC_PASSWORD=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto

BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
TZ=Asia/Seoul
PUBLIC_APP_ORIGIN=https://your-production-domain.example
