NODE_ENV=production
APP_ENV=production
PORT=8090
REQUIRE_HTTPS=true
ALLOWED_ORIGINS=https://movemap.example

# Production secrets must be stored in the hosting provider or cloud secret manager.
AUTH_PROVIDER=
NAVER_MAP_NCP_KEY_ID=
EXPO_PUBLIC_API_BASE_URL=https://api.movemap.example
DATABASE_URL_SECRET_NAME=movemap/prod/database-url
AES_256_GCM_KEY_SECRET_NAME=movemap/prod/patient-field-key
SESSION_SECRET_NAME=movemap/prod/session-secret
FILE_STORAGE_BUCKET_SECRET_NAME=movemap/prod/private-file-bucket

# Production must never use local JSON DB files.
MOVEMAP_DB_PATH=
LOCAL_ADMIN_PASSWORD=
