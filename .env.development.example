NODE_ENV=development
APP_ENV=development
PORT=8090
REQUIRE_HTTPS=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8090

# Local-only values. Put real values in .env.development, not in GitHub.
LOCAL_ADMIN_PASSWORD=change-this-in-your-local-env
NAVER_MAP_NCP_KEY_ID=
MOVEMAP_DB_PATH=server/data/db.local.json
EXPO_PUBLIC_API_BASE_URL=http://localhost:8090

# Do not use real patient or center owner data in development.
DATABASE_URL_SECRET_NAME=
AES_256_GCM_KEY_SECRET_NAME=
SESSION_SECRET_NAME=
FILE_STORAGE_BUCKET_SECRET_NAME=
