map $http_cf_connecting_ip $movemap_client_ip {
  default $http_cf_connecting_ip;
  ""      $remote_addr;
}

limit_req_zone $movemap_client_ip zone=login_limit:10m rate=10r/m;
limit_req_zone $movemap_client_ip zone=upload_limit:10m rate=30r/m;

upstream movemap_app {
  server production-app:3000;
  keepalive 32;
}

server {
  listen 80;
  listen [::]:80;
  server_name ${MOVEMAP_DOMAIN};

  location = /healthz {
    proxy_pass http://movemap_app;
    access_log off;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${MOVEMAP_DOMAIN};

  ssl_certificate /etc/nginx/tls/origin.crt;
  ssl_certificate_key /etc/nginx/tls/origin.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  client_max_body_size 4m;
  server_tokens off;

  add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location = /healthz {
    proxy_pass http://movemap_app;
    access_log off;
  }

  location = /api/login {
    limit_req zone=login_limit burst=5 nodelay;
    proxy_pass http://movemap_app;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $movemap_client_ip;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $movemap_client_ip;
  }

  location = /api/uploads {
    limit_req zone=upload_limit burst=10 nodelay;
    proxy_request_buffering off;
    proxy_pass http://movemap_app;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $movemap_client_ip;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $movemap_client_ip;
  }

  location / {
    proxy_pass http://movemap_app;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $movemap_client_ip;
    proxy_set_header X-Forwarded-For $movemap_client_ip;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
  }
}
